# Kplor Lead Notification Configuration
# Copy this file to .env.local to test locally (and add GOOGLE_SCRIPT_URL in Vercel for production)

# Option 1 (Primary): Google Sheets + Instant Gmail Alerts
# Appends every callback/contact lead to your Google Sheet and emails
# bharadhwaj@kplor.com, mukil@kplor.com, and sanjeeth@kplor.com via Apps Script.
GOOGLE_SCRIPT_URL=

# Option 2 (Optional): Chat Webhook (Discord, Slack, Zapier, Make, etc.)
# For Discord: Channel Settings -> Integrations -> Webhooks -> Copy Webhook URL
# For Slack: Incoming Webhook URL
NOTIFICATION_WEBHOOK_URL=
